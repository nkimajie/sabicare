# Copy this file to .env.local and fill in your key. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: change the model used for symptom extraction
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: MojoAuth passwordless login (from your MojoAuth dashboard, OIDC application)
# Callback URL to register in MojoAuth: http://localhost:3000/api/auth/callback/mojoauth
# AUTH_MOJOAUTH_ISSUER=
# AUTH_MOJOAUTH_ID=
# AUTH_MOJOAUTH_SECRET=
# AUTH_SECRET=   # any long random text, e.g. from: npx auth secret

# Optional: save signed-in users' birth plans, encrypted, in Supabase (run supabase/schema.sql first)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=     # the secret key, server only
# PLAN_ENCRYPTION_KEY=     # 32 random bytes, base64: openssl rand -base64 32
